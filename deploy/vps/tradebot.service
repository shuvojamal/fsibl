[Unit]
Description=Trading bot, one pass (Binance Spot testnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
Group=tradebot
EnvironmentFile=/etc/tradebot.env
ExecStart=/opt/tradebot/repo/deploy/vps/run.sh
TimeoutStartSec=15min
# hardening: the bot needs its repo, the network and nothing else
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/tradebot /tmp
PrivateTmp=yes
ProtectHome=yes
